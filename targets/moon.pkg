// moonsting targets: the demo corpus shipped with the CLI.
//
// Two of these are ordinary parsers (JSON, CSV) with hand-written seeds; the
// third is a *differential pair* of varint decoders where one implementation
// is subtly wrong. The pair exists so the differential oracle can be
// demonstrated end-to-end without depending on any external package.
import {
  "QYF795/moonsting/core",
  "QYF795/moonsting/cov",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/bigint",
  "moonbitlang/core/string",
}
