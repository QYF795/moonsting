// moonsting coverage.
//
// Two backends, deliberately keeping the *interface* stable so the feedback
// source can be swapped without touching the engine:
//
//   Buckets  -no compiler support needed: a signature is derived from the
//              observable result (output content, output length class, error
//              class). It is weak, but it runs on every backend and it is the
//              default, so `moonx fuzz run` works out of the box.
//
//   Edges    -real edge identifiers from an instrumented build
//              (`moon test --enable-coverage` writes `moonbit_coverage_*.txt`).
//              The parser is tolerant on purpose: the artifact format is
//              internal and will change, so anything that cannot be parsed is
//              skipped rather than fatal, and the location text is hashed into
//              an edge id instead of being interpreted.
import {
  "moonsting/core",
  "moonbitlang/core/encoding/utf8",
}
