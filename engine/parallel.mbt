///|
/// Several workers at once.
///
/// One round = N batches generated by the parent, N launcher scripts, N workers
/// running concurrently, then one fold of all results. The corpus stays in the
/// parent, so parallelism never needs a shared-memory protocol: candidates go
/// out as files, results come back as files, the parent merges them in order.
///
/// Why a done file instead of waiting for the process: `system()` blocks, and
/// `start /b` gives no handle. The child script therefore always writes a done
/// file containing its exit code, and the parent polls for those files.

///|
fn Session::prepare_job(
  self : Session,
  exe : String,
  index : Int32,
  batch : Array[Bytes],
  paths : Array[String],
) -> Unit {
  let tag = index.to_string()
  let suffix = if @proc.is_windows() { ".cmd" } else { ".sh" }
  let batch_path = @proc.temp_path("batch" + tag + ".txt")
  let out_path = @proc.temp_path("out" + tag + ".txt")
  let done_path = @proc.temp_path("done" + tag + ".txt")
  let script_path = @proc.temp_path("job" + tag + suffix)
  let text = StringBuilder()
  let mut i = 0
  while i < batch.length() {
    text.write_string(@core.hex_all(batch[i]))
    text.write_string("\n")
    i = i + 1
  }
  ignore(@proc.write_file(batch_path, @utf8.encode(text.to_string())))
  ignore(
    @proc.write_file(
      script_path,
      @utf8.encode(
        @proc.script_for(
          spawn_path(exe),
          self.case_.name(),
          batch_path,
          out_path,
          done_path,
        ),
      ),
    ),
  )
  paths.push(batch_path)
  paths.push(out_path)
  paths.push(done_path)
  paths.push(script_path)
}

///|
/// Spin until every done file exists or the budget runs out. A plain busy wait:
/// the workers take tens of milliseconds, and a sleep primitive would be one
/// more thing that differs between platforms.
fn await_jobs(paths : Array[String], jobs : Int32, budget_ms : UInt64) -> Bool {
  let started = @env.now()
  let mut pending = true
  while pending && @env.now() - started < budget_ms {
    pending = false
    let mut j = 0
    while j < jobs {
      let done_path = paths[j * 4 + 2]
      if @proc.read_file(done_path).length() == 0 {
        pending = true
      }
      j = j + 1
    }
    if pending {
      let spin = @env.now()
      while @env.now() - spin < 2UL {
        ()
      }
    }
  }
  !pending
}

///|
fn Session::run_round(
  self : Session,
  exe : String,
  jobs : Int32,
  batch_size : Int32,
) -> Unit {
  let batches : Array[Array[Bytes]] = []
  // One budget for the whole round: each job draws from it, so four workers do
  // not each run a full batch past `--max-execs`.
  let mut budget = self.config_.max_execs() - self.stats_.execs()
  let mut j = 0
  while j < jobs {
    let batch : Array[Bytes] = []
    let mut attempts = 0
    while batch.length() < batch_size &&
          batch.length() < budget &&
          attempts < batch_size * 4 {
      let candidate = self.candidate()
      attempts = attempts + 1
      if candidate.length() > 0 {
        batch.push(candidate)
      }
    }
    budget = budget - batch.length()
    if batch.length() > 0 {
      batches.push(batch)
    }
    j = j + 1
  }
  if batches.length() == 0 {
    return
  }
  let paths : Array[String] = []
  let scripts : Array[String] = []
  let mut k = 0
  while k < batches.length() {
    self.prepare_job(exe, k, batches[k], paths)
    scripts.push(paths[k * 4 + 3])
    k = k + 1
  }
  ignore(@proc.launch_many(scripts))
  ignore(await_jobs(paths, batches.length(), 120000UL))
  let mut m = 0
  while m < batches.length() {
    let batch_path = paths[m * 4 + 0]
    let out_path = paths[m * 4 + 1]
    let done_path = paths[m * 4 + 2]
    let script_path = paths[m * 4 + 3]
    let code = int_of(@utf8.decode_lossy(@proc.read_file(done_path)))
    let results = split_lines(@proc.read_file(out_path))
    self.absorb(batches[m], results, code)
    @proc.remove_file(batch_path)
    @proc.remove_file(out_path)
    @proc.remove_file(done_path)
    @proc.remove_file(script_path)
    m = m + 1
  }
}
