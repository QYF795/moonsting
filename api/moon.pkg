// moonsting api: the programmatic entry point.
//
// `cli` is argument parsing and nothing else; this package is what an embedder
// (a CI job, a test harness, an agent tool) should depend on. Keeping it
// separate also means the end-to-end tests have a non-main home, which the
// toolchain requires for blackbox tests.
import {
  "QYF795/moonsting/core",
  "QYF795/moonsting/engine",
  "QYF795/moonsting/report",
  "QYF795/moonsting/targets",
}
